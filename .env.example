# Токен от @BotFather
BOT_TOKEN=123456789:AA...

# Модель и адаптер
BASE_MODEL=Vikhrmodels/Vikhr-Qwen-2.5-1.5B-Instruct
ADAPTER_PATH=./adapter

# Поведение
BOT_NAME=ЦУтолк
HISTORY_MAXLEN=8
REPLY_PROBABILITY=0.15
PROACTIVE_ENABLED=1
PROACTIVE_INTERVAL_HOURS=12
CHATS_FILE=./chats.json

# Inline-режим ("@botname текст" из любого чата).
# Требует включения у BotFather: /setinline
INLINE_ENABLED=1
INLINE_DEBOUNCE=0.7
INLINE_CACHE_SIZE=128

# В личке отвечать на каждое сообщение
PRIVATE_ALWAYS_REPLY=1

# Генерация
MAX_NEW_TOKENS=128
TEMPERATURE=0.7
TOP_K=20
TOP_P=0.8
REPETITION_PENALTY=1.1
# Сколько раз перегенерировать, если ответ состоял из одних команд
GEN_MAX_ATTEMPTS=3

# Потоки torch на CPU (0 = не трогать; на VPS обычно = числу ядер)
TORCH_THREADS=0
